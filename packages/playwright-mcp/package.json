{
  "name": "@madhupe-max/playwright-mcp",
  "version": "0.0.68",
  "description": "Playwright Tools for MCP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madhupe-max/playwright-mcp.git"
  },
  "homepage": "https://github.com/madhupe-max/playwright-mcp",
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "madhupe-max"
  },
  "license": "Apache-2.0",
  "mcpName": "io.github.madhupe-max/playwright-mcp",
  "scripts": {
    "lint": "node update-readme.js",
    "test": "playwright test",
    "ctest": "playwright test --project=chrome",
    "ftest": "playwright test --project=firefox",
    "wtest": "playwright test --project=webkit",
    "dtest": "MCP_IN_DOCKER=1 playwright test --project=chromium-docker",
    "build": "echo OK",
    "npm-publish": "npm run lint && npm run test && npm publish"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "dependencies": {
    "playwright": "1.59.0-alpha-1773608981000",
    "playwright-core": "1.59.0-alpha-1773608981000"
  },
  "bin": {
    "playwright-mcp": "cli.js"
  }
}
